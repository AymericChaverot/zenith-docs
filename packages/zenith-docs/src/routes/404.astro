---
import Page from '../components/layout/Page.astro';
import { docsSchema } from '../content';
import { defaultLocale, getRouteData, translationsFor } from '../route-data';

const t = translationsFor(defaultLocale);
const entry = {
  id: '404',
  data: docsSchema().parse({
    title: t['page.notFound'],
    description: t['page.notFoundBody'],
    toc: false,
  }),
};
Astro.locals.zenith = await getRouteData(entry, [], { locale: defaultLocale.key });
---

<Page>
  <div class="zd-not-found">
    <a class="zd-pagination-link" href={import.meta.env.BASE_URL}>{t['page.home']}</a>
  </div>
</Page>
