---
import { Font } from 'astro:assets';

const { config, title, description, url, entry, alternates, locale, ogImage } = Astro.locals.zenith;
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const pageTitle = title === config.title ? title : `${title} | ${config.title}`;
const pageDescription = description ?? config.description;
const canonical = Astro.site ? new URL(url, Astro.site).href : undefined;
const noindex = entry.id === '404' || entry.data.draft;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
{pageDescription && <meta name="description" content={pageDescription} />}
{canonical && <link rel="canonical" href={canonical} />}
{
  alternates.length > 1 &&
    alternates.map(({ locale: other, url: alternate }) => (
      <link rel="alternate" hreflang={other.lang} href={absolute(alternate)} />
    ))
}
{
  config.llms && (
    <link
      rel="alternate"
      type="text/markdown"
      href={`${import.meta.env.BASE_URL}${entry.id}.md`}
      title="Markdown source"
    />
  )
}
{noindex && <meta name="robots" content="noindex" />}
<link rel="icon" href={config.favicon} />
{
  config.fonts && (
    <>
      <Font cssVariable={'--zd-font-sans' as never} preload />
      <Font cssVariable={'--zd-font-mono' as never} />
    </>
  )
}
{Astro.site && <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />}
<meta name="generator" content={`ZenithDocs, ${Astro.generator}`} />
<meta property="og:type" content="article" />
<meta property="og:site_name" content={config.title} />
<meta property="og:locale" content={locale.lang.replace('-', '_')} />
<meta property="og:title" content={title} />
{pageDescription && <meta property="og:description" content={pageDescription} />}
{canonical && <meta property="og:url" content={canonical} />}
{
  ogImage && !noindex && (
    <>
      <meta property="og:image" content={absolute(ogImage)} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={title} />
    </>
  )
}
<meta name="twitter:card" content={ogImage && !noindex ? 'summary_large_image' : 'summary'} />
<script
  is:inline
  type="speculationrules"
  set:html={JSON.stringify({
    prerender: [{ where: { href_matches: `${import.meta.env.BASE_URL}*` }, eagerness: 'moderate' }],
  })}
/>
<script is:inline>
  (() => {
    const root = document.documentElement;
    let stored;
    try {
      stored = localStorage.getItem('zd-theme');
    } catch {}
    const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    root.classList.toggle('theme-dark', dark);
    root.classList.toggle('theme-light', !dark);
    root.setAttribute('data-js', '');
  })();
</script>
