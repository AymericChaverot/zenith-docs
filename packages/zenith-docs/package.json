{
  "name": "zenith-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Static, lightweight and themeable documentation engine for Astro",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./content": "./src/content.ts",
    "./components": "./src/components.ts",
    "./components/*": "./src/components/*",
    "./routes/*": "./src/routes/*",
    "./styles/*": "./src/styles/*",
    "./markdown": "./src/markdown/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "test": "vitest run",
    "check": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "astro": "^7.3.0"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@shikijs/transformers": "^4.4.3",
    "github-slugger": "^2.0.0",
    "mdast-util-directive": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "pagefind": "^1.5.2",
    "satteri": "^0.10.5",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.3",
    "astro": "^7.3.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
