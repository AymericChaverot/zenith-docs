{
  "name": "zenith-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Static, lightweight and themeable documentation engine for Astro",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": "github:AymericChaverot/zenith-docs",
  "bin": {
    "zenith": "./src/cli/index.mjs"
  },
  "files": [
    "src",
    "virtual.d.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./config": {
      "types": "./src/config.ts",
      "default": "./src/define-config.mjs"
    },
    "./content": "./src/content.ts",
    "./components": "./src/components.ts",
    "./components/*": "./src/components/*",
    "./icons": "./src/icons.ts",
    "./themes": "./src/themes.ts",
    "./routes/*": "./src/routes/*",
    "./styles/*": "./src/styles/*",
    "./markdown": "./src/markdown/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "dev": "pnpm --filter docs dev",
    "build": "pnpm --filter docs build",
    "preview": "pnpm --filter docs preview",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "astro": "^7.3.0"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/geist": "^5.3.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@shikijs/transformers": "^4.4.3",
    "github-slugger": "^2.0.0",
    "mdast-util-directive": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "pagefind": "^1.5.2",
    "satori": "^0.33.4",
    "satteri": "^0.10.5",
    "shiki": "^4.4.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.3",
    "astro": "^7.3.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
