---
import { resolveCallout } from '../callouts';

interface Props {
  /**
   * `note`, `tip`, `important`, `success`, `warning` or `danger`,
   * or an alias like `info`, `warn`, `caution`, `error`.
   */
  type?: string;
  title?: string;
}

const callout = resolveCallout(Astro.props.type ?? 'note') ?? resolveCallout('note')!;
const title = Astro.props.title ?? callout.title;
---

<aside class="zd-callout" data-callout={callout.type}>
  <p class="zd-callout-title">{title}</p>
  <div class="zd-callout-body"><slot /></div>
</aside>
