---
import { flattenTree } from '../../page-tree';
import { baseUrl } from '../../urls';
import Icon from '../Icon.astro';
import SidebarTree from '../SidebarTree.astro';
import InjectionPoint from './InjectionPoint.astro';

const { config, locale, sidebar, t, tree, url } = Astro.locals.zenith;

const tabs = sidebar.tabs.map((tab) => ({
  name: tab.name,
  description: tab.description,
  icon: tab.icon ?? 'layers',
  url: tab.index?.url ?? flattenTree(tab.children)[0]?.url,
  active: tab === sidebar.activeTab,
}));

const hasRootContent = tree.children.some((node) => node.type !== 'folder' || !node.root);
if (tabs.length > 0 && hasRootContent) {
  tabs.unshift({
    name: t['nav.docs'],
    description: undefined,
    icon: 'book',
    url: `${baseUrl()}${locale.prefix}`,
    active: !sidebar.activeTab,
  });
}
---

<aside id="zd-sidebar" class="zd-sidebar" popover aria-label={t['nav.label']}>
  <button
    class="zd-icon-button zd-sidebar-close"
    type="button"
    popovertarget="zd-sidebar"
    popovertargetaction="hide"
    aria-label={t['nav.close']}
  >
    <Icon name="close" size={18} />
  </button>
  {
    tabs.length > 0 && (
      <nav class="zd-sidebar-tabs" aria-label={t['nav.sections']}>
        {tabs.map((tab) => (
          <a class="zd-sidebar-tab" href={tab.url} aria-current={tab.active ? 'true' : undefined}>
            <span class="zd-sidebar-tab-icon">
              <Icon name={tab.icon} size={14} />
            </span>
            <span>{tab.name}</span>
          </a>
        ))}
      </nav>
    )
  }
  <InjectionPoint name="sidebarTop" class="zd-slot-sidebar-top" />
  <nav aria-label={t['nav.pages']}>
    <SidebarTree nodes={sidebar.nodes} url={url} />
  </nav>
  {
    config.links.length > 0 && (
      <ul class="zd-sidebar-extra">
        {config.links.map((link) => (
          <li>
            <a class="zd-sidebar-link" href={link.href}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
  <InjectionPoint name="sidebarBottom" class="zd-slot-sidebar-bottom" />
</aside>
<script is:inline>
  // Keep the sidebar scroll position across page loads.
  (() => {
    const sidebar = document.getElementById('zd-sidebar');
    if (!sidebar) return;
    const restore = () => {
      try {
        const saved = sessionStorage.getItem('zd-sidebar-scroll');
        if (saved) sidebar.scrollTop = Number(saved);
      } catch {}
    };
    restore();
    addEventListener('pagereveal', restore);
    addEventListener('pagehide', () => {
      try {
        sessionStorage.setItem('zd-sidebar-scroll', String(sidebar.scrollTop));
      } catch {}
    });
  })();

  // Close the mobile menu when the viewport grows past the breakpoint.
  matchMedia('(min-width: 56.0625rem)').addEventListener('change', (event) => {
    const sidebar = document.getElementById('zd-sidebar');
    if (event.matches && sidebar && sidebar.matches(':popover-open')) sidebar.hidePopover();
  });
</script>
