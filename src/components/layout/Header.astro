---
import LocaleSwitcher from 'virtual:zenith/components/LocaleSwitcher';
import VersionSwitcher from 'virtual:zenith/components/VersionSwitcher';
import Search from 'virtual:zenith/components/Search';
import ThemeToggle from 'virtual:zenith/components/ThemeToggle';
import { withBase } from '../../urls';
import Icon from '../Icon.astro';
import InjectionPoint from './InjectionPoint.astro';

const { config, locale, t } = Astro.locals.zenith;
const showTitle = !config.logo?.replacesTitle;
const home = `${import.meta.env.BASE_URL}${locale.prefix}`;
---

<header class="zd-header">
  <button
    class="zd-icon-button zd-menu-button"
    type="button"
    popovertarget="zd-sidebar"
    aria-label={t['nav.open']}
  >
    <Icon name="menu" size={18} />
  </button>
  <a class="zd-header-title" href={home}>
    {
      config.logo?.svg ? (
        <span
          class="zd-logo"
          role={showTitle ? undefined : 'img'}
          aria-label={showTitle ? undefined : config.logo.alt || config.title}
          aria-hidden={showTitle ? 'true' : undefined}
          set:html={config.logo.svg}
        />
      ) : (
        config.logo && (
          <img class="zd-logo" src={withBase(config.logo.src)} alt={showTitle ? '' : config.logo.alt || config.title} />
        )
      )
    }
    {showTitle && <span>{config.title}</span>}
  </a>
  {
    config.links.length > 0 && (
      <nav class="zd-header-nav" aria-label={t['nav.main']}>
        {config.links.map((link) => (
          <a class="zd-header-link" href={link.href}>
            {link.label}
          </a>
        ))}
      </nav>
    )
  }
  <div class="zd-header-actions">
    <Search />
    <VersionSwitcher />
    <LocaleSwitcher />
    {
      config.github && (
        <a class="zd-icon-button" href={config.github} aria-label="GitHub">
          <Icon name="github" size={18} />
        </a>
      )
    }
    <ThemeToggle />
    <InjectionPoint name="headerEnd" />
  </div>
</header>
