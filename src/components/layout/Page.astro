---
import '../../styles/zenith.css';
import 'virtual:zenith/user-css';

import Breadcrumb from 'virtual:zenith/components/Breadcrumb';
import Head from 'virtual:zenith/components/Head';
import Header from 'virtual:zenith/components/Header';
import PageActions from 'virtual:zenith/components/PageActions';
import PageFooter from 'virtual:zenith/components/PageFooter';
import PageTitle from 'virtual:zenith/components/PageTitle';
import Pagination from 'virtual:zenith/components/Pagination';
import Sidebar from 'virtual:zenith/components/Sidebar';
import TableOfContents from 'virtual:zenith/components/TableOfContents';
import { resolveAccent } from '../../colors';
import Icon from '../Icon.astro';
import InjectionPoint from './InjectionPoint.astro';

const { config, entry, toc, locale, t, translated } = Astro.locals.zenith;
const full = entry.data.full;
const hasToc = toc.length > 0 && !full;
const accent = resolveAccent(config.accent);
// A custom accent sets the variables the presets set in `theme.css`.
const accentStyle =
  accent.name === 'custom'
    ? {
        '--zd-accent-light': accent.light,
        '--zd-accent-dark': accent.dark,
        '--zd-accent-contrast-light': accent.contrastLight,
        '--zd-accent-contrast-dark': accent.contrastDark,
      }
    : undefined;
---

<!doctype html>
<html
  lang={locale.lang}
  dir={locale.dir}
  class="theme-light"
  data-accent={accent.name}
  style={accentStyle}
  data-fonts={config.fonts || undefined}
  data-theme={config.theme}
  data-backdrop={config.backdrop}
  data-backdrop-position={config.backdropPosition}
  data-full={full ? '' : undefined}
>
  <head>
    <Head />
    <InjectionPoint name="head" />
  </head>
  <body>
    {config.backdrop !== 'none' && <div class="zd-backdrop" aria-hidden="true" />}
    <a class="zd-skip" href="#zd-content">{t.skip}</a>
    <InjectionPoint name="banner" class="zd-slot-banner" />
    <Header />
    <div class="zd-layout" data-toc={hasToc ? '' : undefined}>
      <Sidebar />
      <main id="zd-content" class="zd-main">
        <article class="zd-article" data-pagefind-body>
          <div data-pagefind-ignore>
            <Breadcrumb />
          </div>
          <PageTitle />
          <PageActions />
          {
            toc.length > 0 && (
              <details
                class="zd-toc-mobile"
                style={full ? 'display: block' : undefined}
                data-pagefind-ignore
              >
                <summary>
                  <Icon name="list" />
                  {t['toc.title']}
                  <Icon name="chevron" size={14} class="zd-chevron" />
                </summary>
                <TableOfContents />
              </details>
            )
          }
          {
            !translated && (
              <aside class="zd-callout zd-untranslated" data-callout="note" data-pagefind-ignore>
                <p class="zd-callout-title">{t['callout.note']}</p>
                <div class="zd-callout-body">
                  <p>{t['page.untranslated']}</p>
                </div>
              </aside>
            )
          }
          <InjectionPoint name="contentBefore" class="zd-slot-content-before" ignoreSearch />
          <div class="zd-prose">
            <slot />
          </div>
          <InjectionPoint name="contentAfter" class="zd-slot-content-after" ignoreSearch />
          <div data-pagefind-ignore>
            <PageFooter />
            <Pagination />
          </div>
        </article>
      </main>
      {
        hasToc && (
          <aside class="zd-toc-aside">
            <TableOfContents />
            <InjectionPoint name="tocAfter" class="zd-slot-toc-after" />
          </aside>
        )
      }
    </div>
    <InjectionPoint name="footer" class="zd-slot-footer" />
    <script is:inline>
      const copied = (button) => {
        button.setAttribute('data-copied', '');
        setTimeout(() => button.removeAttribute('data-copied'), 1500);
      };
      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target : null;
        for (const menu of document.querySelectorAll('.zd-page-menu[open]')) {
          if (!menu.contains(target)) menu.open = false;
        }
        const page = target && target.closest('[data-copy-page]');
        if (page) {
          // Safari only copies within the click, so the item takes the pending download.
          const text = fetch(page.dataset.copyPage)
            .then((response) => response.text())
            .then((markdown) => new Blob([markdown], { type: 'text/plain' }));
          navigator.clipboard
            .write([new ClipboardItem({ 'text/plain': text })])
            .then(() => copied(page));
          return;
        }
        const button = target && target.closest('[data-copy]');
        const code = button && button.parentElement.querySelector('pre code');
        if (!code) return;
        navigator.clipboard.writeText(code.textContent.replace(/\n$/, '')).then(() => copied(button));
      });
    </script>
  </body>
</html>
