---
import { withBase } from '../urls';
import Icon from './Icon.astro';

interface Props {
  title: string;
  href?: string;
  icon?: string;
}

const { title, href, icon } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="zd-card" href={href && withBase(href)}>
  {
    icon && (
      <span class="zd-card-icon">
        <Icon name={icon} />
      </span>
    )
  }
  <p class="zd-card-title">{title}</p>
  {
    Astro.slots.has('default') && (
      <div class="zd-card-body">
        <slot />
      </div>
    )
  }
</Tag>
