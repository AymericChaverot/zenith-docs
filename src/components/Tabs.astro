---
import TabsScript from './TabsScript.astro';

interface Props {
  /** Tab labels, in order. Built from the `<Tab>` values when omitted. */
  items?: string[];
  defaultValue?: string;
  /** Tabs sharing a group id switch together. */
  groupId?: string;
  /** Remember the selected tab of the group across pages. */
  persist?: boolean;
}

const { items = [], defaultValue = items[0], groupId, persist = false } = Astro.props;
---

<zd-tabs
  class="zd-tabs"
  data-group={groupId}
  data-persist={persist ? '' : undefined}
  data-default={defaultValue}
>
  {items.length > 0 && (
    <div class="zd-tabs-list" role="tablist" data-pagefind-ignore>
      {items.map((item) => (
        <button
          class="zd-tab-trigger"
          type="button"
          role="tab"
          data-value={item}
          aria-selected={item === defaultValue ? 'true' : 'false'}
        >
          {item}
        </button>
      ))}
    </div>
  )}
  <slot />
</zd-tabs>

<TabsScript />
