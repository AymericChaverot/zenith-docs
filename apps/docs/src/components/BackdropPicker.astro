---
const backdrops = [
  'dither',
  'aurora',
  'grid',
  'dots',
  'rays',
  'grain',
  'horizon',
  'horizon-glow',
  'glow',
  'none',
];
const positions = ['left', 'center', 'right'];
---

<div class="accent-picker" role="group" aria-label="Backdrop style">
  {
    backdrops.map((backdrop) => (
      <button type="button" data-backdrop-choice={backdrop}>
        {backdrop}
      </button>
    ))
  }
</div>

<div class="accent-picker" role="group" aria-label="Backdrop position">
  {
    positions.map((position) => (
      <button type="button" data-position-choice={position}>
        {position}
      </button>
    ))
  }
</div>

<script>
  const root = document.documentElement;
  const backdrop = document.querySelector('.zd-backdrop');
  const styleButtons = document.querySelectorAll<HTMLButtonElement>('[data-backdrop-choice]');
  const positionButtons = document.querySelectorAll<HTMLButtonElement>('[data-position-choice]');

  const sync = () => {
    for (const button of styleButtons) {
      button.ariaPressed = String(button.dataset.backdropChoice === root.dataset.backdrop);
    }
    for (const button of positionButtons) {
      button.ariaPressed = String(button.dataset.positionChoice === root.dataset.backdropPosition);
    }
  };

  for (const button of styleButtons) {
    button.addEventListener('click', () => {
      const choice = button.dataset.backdropChoice!;
      root.dataset.backdrop = choice;
      // The element is not rendered when the site is built with `backdrop: 'none'`.
      if (backdrop) backdrop.toggleAttribute('hidden', choice === 'none');
      sync();
    });
  }

  for (const button of positionButtons) {
    button.addEventListener('click', () => {
      root.dataset.backdropPosition = button.dataset.positionChoice!;
      sync();
    });
  }

  sync();
</script>
