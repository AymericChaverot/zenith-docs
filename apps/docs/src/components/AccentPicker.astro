---
const accents = ['neutral', 'emerald', 'teal', 'amber', 'rose', 'violet'];
---

<div class="accent-picker" role="group" aria-label="Accent color">
  {
    accents.map((accent) => (
      <button type="button" data-accent-choice={accent}>
        <span class="accent-swatch" data-swatch={accent} />
        {accent}
      </button>
    ))
  }
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-accent-choice]');
  const sync = () => {
    for (const button of buttons) {
      button.ariaPressed = String(button.dataset.accentChoice === document.documentElement.dataset.accent);
    }
  };
  for (const button of buttons) {
    button.addEventListener('click', () => {
      document.documentElement.dataset.accent = button.dataset.accentChoice;
      sync();
    });
  }
  sync();
</script>

<style is:global>
  .accent-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 1.25rem;
  }

  .accent-picker button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-round);
    color: var(--text-2);
    font-size: 0.875rem;
    text-transform: capitalize;
  }

  .accent-picker button[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--text);
  }

  .accent-swatch {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--swatch);
  }

  .accent-swatch[data-swatch='neutral'] { --swatch: oklch(45% 0.006 286); }
  .accent-swatch[data-swatch='emerald'] { --swatch: oklch(62% 0.13 165); }
  .accent-swatch[data-swatch='teal'] { --swatch: oklch(62% 0.1 195); }
  .accent-swatch[data-swatch='amber'] { --swatch: oklch(72% 0.15 65); }
  .accent-swatch[data-swatch='rose'] { --swatch: oklch(64% 0.18 12); }
  .accent-swatch[data-swatch='violet'] { --swatch: oklch(62% 0.17 290); }
</style>
