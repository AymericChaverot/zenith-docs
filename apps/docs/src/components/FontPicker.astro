---
import { Font } from 'astro:assets';

/**
 * Families of the presets this site does not use, loaded only by this page.
 * Instrument and Martian Mono already come from the `fonts` option.
 */
const families = [
  '--font-geist',
  '--font-geist-mono',
  '--font-newsreader',
  '--font-onest',
  '--font-ibm-plex-mono',
  '--font-schibsted-grotesk',
  '--font-jetbrains-mono',
  '--font-space-grotesk',
  '--font-space-mono',
  '--font-atkinson',
  '--font-literata',
];

const presets = [
  { key: 'instrument', label: 'Instrument', note: 'Default' },
  { key: 'geist', label: 'Geist', note: 'Neutral' },
  { key: 'newsreader', label: 'Newsreader + Onest', note: 'Warm' },
  { key: 'schibsted', label: 'Schibsted Grotesk', note: 'Sober' },
  { key: 'space', label: 'Space Grotesk', note: 'Technical' },
  { key: 'atkinson', label: 'Atkinson', note: 'Legibility' },
  { key: 'literata', label: 'Literata', note: 'Serif body' },
];
---

{families.map((family) => <Font cssVariable={family as never} />)}

<div class="font-picker" role="group" aria-label="Font preset">
  {
    presets.map(({ key, label, note }) => (
      <button type="button" data-font-choice={key}>
        <span class="font-label">{label}</span>
        <span class="font-note">{note}</span>
      </button>
    ))
  }
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-font-choice]');
  const root = document.documentElement;
  const sync = () => {
    const current = root.dataset.fontsPreview ?? root.dataset.fonts ?? 'instrument';
    for (const button of buttons) {
      button.ariaPressed = String(button.dataset.fontChoice === current);
    }
  };
  for (const button of buttons) {
    button.addEventListener('click', () => {
      const choice = button.dataset.fontChoice;
      // The preset of the site needs no override, the others set the same tokens you would.
      if (choice === root.dataset.fonts) delete root.dataset.fontsPreview;
      else root.dataset.fontsPreview = choice;
      sync();
    });
  }
  sync();
</script>

<style is:global>
  .font-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 1.25rem;
  }

  .font-picker button {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    align-items: flex-start;
    padding: 0.5rem 0.875rem;
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-small);
    color: var(--text-2);
    text-align: left;
  }

  .font-picker button[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--text);
  }

  .font-label {
    font-size: 0.9375rem;
    font-weight: var(--primary-bold);
  }

  .font-note {
    font-size: 0.75rem;
    opacity: 0.7;
  }

  /*
   * Each preview sets the three override tokens, exactly as a `customCss` file would.
   * These rules are unlayered, so they win over the preset of the site.
   */
  :root[data-fonts-preview='geist'] {
    --font-body: var(--font-geist);
    --font-mono: var(--font-geist-mono);
    --font-display: var(--font-geist);
    --h1-font-weight: 600;
    --h2-font-weight: 600;
  }

  :root[data-fonts-preview='newsreader'] {
    --font-body: var(--font-onest);
    --font-mono: var(--font-ibm-plex-mono);
    --font-display: var(--font-newsreader);
    --h1-font-weight: 600;
    --h2-font-weight: 600;
  }

  :root[data-fonts-preview='schibsted'] {
    --font-body: var(--font-schibsted-grotesk);
    --font-mono: var(--font-jetbrains-mono);
    --font-display: var(--font-schibsted-grotesk);
    --h1-font-weight: 600;
    --h2-font-weight: 600;
  }

  :root[data-fonts-preview='space'] {
    --font-body: var(--font-space-grotesk);
    --font-mono: var(--font-space-mono);
    --font-display: var(--font-space-grotesk);
    --h1-font-weight: 600;
    --h2-font-weight: 600;
  }

  :root[data-fonts-preview='atkinson'] {
    --font-body: var(--font-atkinson);
    --font-mono: var(--font-jetbrains-mono);
    --font-display: var(--font-atkinson);
    --h1-font-weight: 700;
    --h2-font-weight: 700;
  }

  :root[data-fonts-preview='literata'] {
    --font-body: var(--font-literata);
    --font-mono: var(--font-ibm-plex-mono);
    --font-display: var(--font-literata);
    --h1-font-weight: 600;
    --h2-font-weight: 600;
  }
</style>
